{
  "name": "ai-overlay",
  "version": "1.0.0",
  "description": "Private AI assistant overlay (ChatGPT, Claude, DeepSeek, Gemini) hidden from screen sharing",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.ai.overlay",
    "productName": "AI Overlay",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "portable" }
  }
}
