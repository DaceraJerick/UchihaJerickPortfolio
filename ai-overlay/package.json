{
  "name": "ai-overlay",
  "version": "1.0.1",
  "description": "Private AI assistant overlay (ChatGPT, Claude, DeepSeek, Gemini) hidden from screen sharing",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.ai.overlay",
    "productName": "AI Overlay",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI Overlay",
      "artifactName": "AI-Overlay-Setup.exe"
    },
    "portable": {
      "artifactName": "AI-Overlay-Portable.exe"
    },
    "publish": null
  },
  "author": "AI Overlay"
}